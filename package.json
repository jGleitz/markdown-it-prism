{
  "name": "markdown-it-prism",
  "version": "0.0.0-development",
  "type": "module",
  "description": "Highlights code blocks in markdown-it using Prism.",
  "keywords": [
    "markdown-it",
    "markdown-it-plugin",
    "highlight",
    "prism",
    "prismjs"
  ],
  "homepage": "https://github.com/jGleitz/markdown-it-prism",
  "license": "MIT",
  "author": {
    "name": "Joshua Gleitze",
    "url": "https://joshuagleitze.de"
  },
  "files": [
    "README.md",
    "LICENSE",
    "dist"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "dist/index.d.ts": [
        "dist/index.d.cts"
      ]
    }
  },
  "engines": {
    "node": ">=22.3.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jGleitz/markdown-it-prism.git"
  },
  "scripts": {
    "build": "node scripts/clean-dist.mjs && tsup && node scripts/add-cjs-interop.mjs",
    "format": "eslint --fix .",
    "lint": "npm-run-all lint:types lint:style",
    "lint:types": "tsc -p tsconfig.json",
    "lint:style": "eslint .",
    "lint:package": "publint && attw --pack .",
    "prepack": "pnpm build",
    "unittest": "vitest run",
    "test": "npm-run-all lint unittest",
    "release": "semantic-release"
  },
  "dependencies": {
    "@types/prismjs": "1.26.6",
    "prismjs": "1.30.0"
  },
  "peerDependencies": {
    "markdown-it": "^15.0.0",
    "markdown-it-attrs": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "markdown-it-attrs": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@eslint/js": "10.0.1",
    "@eslint/json": "2.0.1",
    "@stylistic/eslint-plugin": "5.10.0",
    "@types/node": "24.13.3",
    "@typescript/native": "npm:typescript@7.0.2",
    "eslint": "10.9.1",
    "eslint-plugin-yml": "3.8.1",
    "markdown-it": "15.0.1",
    "markdown-it-attrs": "5.0.1",
    "npm-run-all2": "9.0.3",
    "publint": "0.3.24",
    "semantic-release": "25.0.9",
    "tsup": "8.5.1",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.68.0",
    "vitest": "4.1.11"
  },
  "packageManager": "pnpm@11.24.0"
}

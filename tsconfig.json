{
  "compilerOptions": {
    "target": "esnext",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "ignoreDeprecations": "6.0",
    "types": ["node"],
    "allowJs": false,
    "noEmit": true,
    "strict": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "typeRoots": [
      "types",
      "node_modules/@types"
    ],
    "paths": {
      "markdown-it-attrs": ["./types/markdown-it-attrs/index.d.ts"]
    }
  },
  "exclude": ["tsup.config.ts", "test-consuming"]
}
